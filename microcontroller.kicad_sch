	(text_box "DESIGN NOTE:\nCRYSTAL LOAD CAPACITORS\n\nCL = (C1*C2)/(C1+C2) + CS\n\nFOR C1 = C2 = C:\nC = 2*(CL - CS)\n\nHSE (Y1):\nCL = 20 pF\nCS ≈ 10 pF (MCU + PCB EST.)\nC24 = C27 ≈ 20 pF\nUSE C0G/NP0\n\nLSE (Y2):\nCL = 12.5 pF\nCS ≈ 5 pF (INITIAL EST.)\nC33 = C34 ≈ 15 pF\nUSE C0G/NP0\n\nVALUES ARE INITIAL DESIGN VALUES.\nVERIFY/TUNE ON FINAL PCB IF\nFREQUENCY ACCURACY REQUIRES."
		(exclude_from_sim no)
		(at 157.48 16.51 0)
		(size 29.21 41.91)
		(margins 1.3525 1.3525 1.3525 1.3525)
