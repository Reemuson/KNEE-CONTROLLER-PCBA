name: Boardwright Prepare Release Tag
run-name: Prepare ${{ inputs.version }} (${{ inputs.variant }}, ${{ inputs.release_kind }})

on:
  workflow_dispatch:
    inputs:
      version:
        description: Semantic version to release
        required: true
        type: string
      variant:
        description: KiBot variant to accept and tag
        required: true
        default: CHECKED
        type: choice
        options:
          - DRAFT
          - PRELIMINARY
          - CHECKED
          - RELEASED
      release_kind:
        description: GitHub Release state for the tag workflow
        required: true
        default: prerelease
        type: choice
        options:
          - draft
          - prerelease
          - release
      drawing_revision:
        description: Controlled drawing revision for the revision table
        required: true
        type: string
      revision_description:
        description: Revision table description, 60 characters or fewer
        required: true
        type: string

permissions:
  contents: write
  actions: write

concurrency:
  group: boardwright-main
  cancel-in-progress: false

env:
  PYTHONPATH: ${{ github.workspace }}/src
  KIBOT_CONFIG: boardwright_resources/kibot/yaml/kibot_main.yaml
  KIBOT_LOG: kibot_prepare_release.log
  KICAD_VERSION: "9"

jobs:
  prepare:
    name: Prepare ${{ inputs.version }} release state
    runs-on: ubuntu-latest
    if: github.ref_type == 'branch' && github.ref_name == 'main'
    steps:
      - name: Checkout main
        uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0

      - name: Record job start time
        shell: bash
        run: echo "BOARDWRIGHT_JOB_START_EPOCH=$(date +%s)" >> "$GITHUB_ENV"

      - name: Configure git author
        shell: bash
        run: |
          git config user.name "boardwright[bot]"
          git config user.email "boardwright[bot]@users.noreply.github.com"

      - name: Cache Python packages
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ hashFiles('pyproject.toml') }}
          restore-keys: |
            ${{ runner.os }}-pip-

      - name: Install Boardwright
        shell: bash
        run: python -m pip install -e .

      - name: Prepare changelog and release metadata
        shell: bash
        run: |
          version="${{ inputs.version }}"
          variant="${{ inputs.variant }}"
          release_kind="${{ inputs.release_kind }}"
          drawing_revision="${{ inputs.drawing_revision }}"
          revision_description="${{ inputs.revision_description }}"
          release_include_source_archive="$(python -c "import sys; sys.path.insert(0, 'src'); from boardwright.config import load_config; print(str(load_config().release_include_source_archive).lower())")"

          boardwright release "$version" --prepare --allow-dirty --drawing-revision "$drawing_revision" --revision-description "$revision_description"

          cat > .boardwright/release.env <<EOF
          RELEASE_VERSION=$version
          RELEASE_VARIANT=$variant
          RELEASE_KIND=$release_kind
          RELEASE_INCLUDE_SOURCE_ARCHIVE=$release_include_source_archive
          EOF

          {
            echo "## Boardwright Prepare Release"
            echo
            echo "- Version: \`${version}\`"
            echo "- Variant: \`${variant}\`"
            echo "- Release kind: \`${release_kind}\`"
            echo "- Drawing revision: \`${drawing_revision}\`"
            echo "- Revision description: \`${revision_description}\`"
            echo "- Target branch: \`main\`"
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Choose KiBot variant and output set
        shell: bash
        run: |
          variant="${{ inputs.variant }}"

          case "$variant" in
            DRAFT)
              additional_args="--skip-pre draw_fancy_stackup,erc,drc --log $KIBOT_LOG draft_group md_readme"
              ;;
            PRELIMINARY)
              additional_args="--skip-pre erc,drc --log $KIBOT_LOG all_group_k9"
              ;;
            CHECKED|RELEASED)
              additional_args="--log $KIBOT_LOG all_group_k9"
              ;;
            *)
              echo "Unsupported release variant: $variant" >&2
              exit 1
              ;;
          esac

          echo "KIBOT_VARIANT=$variant" >> "$GITHUB_ENV"
          echo "KIBOT_ADDITIONAL_ARGS=$additional_args" >> "$GITHUB_ENV"

      - name: Ensure 3D cache directory
        run: mkdir -p ~/cache_3d

      - name: Cache 3D models
        uses: actions/cache@v4
        with:
          path: ~/cache_3d
          key: ${{ runner.os }}-kicad-${{ env.KICAD_VERSION }}-3d
          restore-keys: |
            ${{ runner.os }}-kicad-${{ env.KICAD_VERSION }}-3d-

      - name: Install bundled KiCad/PDF fonts
        shell: bash
        run: |
          mkdir -p ~/.local/share/fonts
          cp boardwright_resources/kibot/resources/fonts/*.ttf ~/.local/share/fonts/
          fc-cache -f ~/.local/share/fonts || true

      - name: Generate revision table variables
        if: env.KIBOT_VARIANT != 'DRAFT'
        shell: bash
        run: python -m boardwright revision-history
      - name: Prepare Boardwright PDF table placeholders
        if: env.KIBOT_VARIANT != 'DRAFT'
        shell: bash
        run: python boardwright_resources/kibot/resources/scripts/prepare_pcb_tables.py .

      - name: Generate KiBot PDF table CSV sources
        if: env.KIBOT_VARIANT != 'DRAFT'
        uses: INTI-CMNB/KiBot@v2_dk9
        with:
          additional_args: --skip-pre draw_fancy_stackup,erc,drc --log kibot_prepare_tables.log table_sources
          variant: ${{ env.KIBOT_VARIANT }}
          config: ${{ env.KIBOT_CONFIG }}
          cache3D: YES

      - name: Prune empty conditional PDF pages
        if: env.KIBOT_VARIANT != 'DRAFT'
        shell: bash
        run: python boardwright_resources/kibot/resources/scripts/prune_pdf_pages.py .

      - name: Normalize project ownership before combined PDF prep
        if: env.KIBOT_VARIANT != 'DRAFT'
        shell: bash
        run: sudo chown -R "$USER:$USER" . 2>/dev/null || true

      - name: Prepare native combined PDF contents
        if: env.KIBOT_VARIANT != 'DRAFT'
        shell: bash
        run: python boardwright_resources/kibot/resources/scripts/prepare_combined_pdf_native.py .

      - name: Generate accepted outputs
        uses: INTI-CMNB/KiBot@v2_dk9
        with:
          additional_args: ${{ env.KIBOT_ADDITIONAL_ARGS }}
          variant: ${{ env.KIBOT_VARIANT }}
          config: ${{ env.KIBOT_CONFIG }}
          cache3D: YES

      - name: Regenerate fabrication PDF metadata
        if: env.KIBOT_VARIANT != 'DRAFT'
        uses: INTI-CMNB/KiBot@v2_dk9
        with:
          additional_args: --skip-pre draw_fancy_stackup,erc,drc --log kibot_prepare_fabrication_document.log pdf_fabrication zip_compress_fab
          variant: ${{ env.KIBOT_VARIANT }}
          config: boardwright_resources/kibot/yaml/kibot_document_fabrication.generated.yaml
          cache3D: YES

      - name: Regenerate assembly PDF metadata
        if: env.KIBOT_VARIANT != 'DRAFT'
        uses: INTI-CMNB/KiBot@v2_dk9
        with:
          additional_args: --skip-pre draw_fancy_stackup,erc,drc --log kibot_prepare_assembly_document.log pdf_assembly
          variant: ${{ env.KIBOT_VARIANT }}
          config: boardwright_resources/kibot/yaml/kibot_document_assembly.generated.yaml
          cache3D: YES

      - name: Normalize generated output ownership
        shell: bash
        run: sudo chown -R "$USER:$USER" Schematic Manufacturing assets HTML KiRI Testing Reports README.md 2>/dev/null || true
      - name: Install optional PDF combiner dependency
        shell: bash
        run: python -m pip install "pypdf>=4.0"

      - name: Create optional combined review PDF
        shell: bash
        run: python boardwright_resources/kibot/resources/scripts/combine_review_pdf.py .

      - name: Clean generated outputs
        shell: bash
        run: python boardwright_resources/kibot/resources/scripts/clean_generated_outputs.py .

      - name: Check generated README
        shell: bash
        run: |
          if [[ ! -s README.md ]]; then
            echo "README.md was not generated by KiBot." >&2
            exit 1
          fi

      - name: Discard generated source side effects
        shell: bash
        run: |
          git checkout HEAD -- boardwright_resources/kibot/yaml/kibot_main.yaml 2>/dev/null || true
          git clean -f boardwright_resources/kibot/yaml/kibot_document_*.generated.yaml 2>/dev/null || true
          git checkout HEAD -- '*.kicad_pcb' '*.kicad_pro' '*.kicad_dru' '*.kicad_prl' '*.kicad_sch' || true
          git clean -f '*.kicad_pcb' '*.kicad_pro' '*.kicad_dru' '*.kicad_prl' '*.kicad_sch' || true

      - name: Commit accepted release state
        shell: bash
        run: |
          version="${{ inputs.version }}"
          variant="${{ inputs.variant }}"

          git rm -r --ignore-unmatch HTML KiRI Manufacturing Reports Schematic Testing
          git add CHANGELOG.md .boardwright/project.yaml .boardwright/document_revisions.yaml
          git add -f .boardwright/revision_history_variables.env .boardwright/release.env
          git add README.md assets/renders/*.png || true

          if git diff --cached --quiet; then
            echo "No release changes to commit." >&2
            exit 1
          fi

          git commit -m "release: prepare ${version} (${variant})"
          git push origin HEAD:main

      - name: Create and push tag
        shell: bash
        run: |
          version="${{ inputs.version }}"

          if git rev-parse --verify --quiet "refs/tags/$version"; then
            echo "Local tag already exists: $version" >&2
            exit 1
          fi
          if git ls-remote --exit-code --tags origin "refs/tags/$version" >/dev/null 2>&1; then
            echo "Remote tag already exists: $version" >&2
            exit 1
          fi

          git tag "$version"
          git push origin "$version"

      - name: Dispatch tag release workflow
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          version="${{ inputs.version }}"
          gh workflow run release.yaml --ref "$version" --repo "$GITHUB_REPOSITORY"

      - name: Upload prepare logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: boardwright-prepare-release-logs
          path: |
            kibot_prepare*.log

      - name: Summarize job timing
        if: always()
        shell: bash
        run: |
          end_epoch="$(date +%s)"
          start_epoch="${BOARDWRIGHT_JOB_START_EPOCH:-$end_epoch}"
          elapsed="$((end_epoch - start_epoch))"
          {
            echo "## CI Timing"
            echo
            echo "- Job elapsed: ${elapsed}s"
            echo "- Cache note: 3D assets are cached with actions/cache@v4."
            echo "- Cache note: pip downloads are cached with actions/cache@v4."
          } >> "$GITHUB_STEP_SUMMARY"
